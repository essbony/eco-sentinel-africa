# Copie vers .env et ajuste les valeurs — ne jamais commiter de vraies clés
APP_NAME=eco-sentinel-africa
ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production

# ── Meta API unifiée (client OpenAI compatible, API Responses) ──
# Source unique pour tous les modèles Meta : Vision + Router + Spark + Analyse
BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=

# ── Vision (Meta SAM 3.1) ──
VISION_PROVIDER=meta
VISION_MODEL=sam-3.1
VISION_TIMEOUT_S=10
VISION_CATEGORIES=waste,plastic_bottle,container,debris,dumping
VISION_CONFIDENCE_THRESHOLD=0.5

# ── Router (Meta Muse Wonder) ──
ROUTER_PROVIDER=meta
ROUTER_MODEL=muse-wonder-1.0
ROUTER_TIMEOUT_S=15

# ── Agents spécialisés (Meta Muse Spark 1.3) ──
SPARK_PROVIDER=meta
SPARK_MODEL=muse-spark-1.3
SPARK_TIMEOUT_S=15

# ── Analyse (compat — utilise Meta si MODEL_API_KEY présent) ──
# OPENAI_API_KEY est un alias de MODEL_API_KEY (fallback automatique)
OPENAI_API_KEY=
OPENAI_MODEL=muse-spark-1.3
OPENAI_TIMEOUT_S=20

# ── Ingestion vidéo ──
INGESTION_MAX_QUEUE_SIZE=100
INGESTION_SAMPLE_FPS=1.0
INGESTION_MAX_IMAGE_BYTES=5000000

# ── Événements / Alertes ──
EVENT_DEDUP_WINDOW_S=60
EVENT_PERSISTENCE_THRESHOLD=2
ALERT_MIN_RISK=medium
ALERT_MIN_CONFIDENCE=0.6

# Cible et données d'évaluation
EVAL_TARGET_URL=http://app:8000
EVAL_DATASET=evals/datasets/golden.jsonl
EVAL_RESULTS_DIR=/app/evals/results

# Persistance (optionnel)
DATABASE_URL=

# ── Évaluation (legacy) ──
OPENAI_API_VERSION=2024-02-15-preview
CONFIDENT_AI_API_KEY=
